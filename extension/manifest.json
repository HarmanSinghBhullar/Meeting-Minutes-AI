{
  "manifest_version": 3,
  "name": "Meeting Intelligence",
  "version": "0.1.0",
  "description": "Accurate, verifiable meeting minutes from your browser.",

  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Meeting Intelligence"
  },

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/offscreen/offscreen.html",
        "src/permission/index.html",
        "src/meeting/index.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "minimum_chrome_version": "116"
}
