# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meeting_minutes

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# The extension's origin, e.g. chrome-extension://<id>. Comma-separated.
CORS_ORIGINS=chrome-extension://

# --- Audio storage ---
# Directory for raw uploaded chunks and normalized WAV files.
STORAGE_DIR=./storage
# Path to the ffmpeg binary (must be installed separately).
FFMPEG_BIN=ffmpeg

# --- Transcription (faster-whisper) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
# int8_float16 keeps large-v3 under ~2GB VRAM — required on a 4GB card.
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_VAD_FILTER=true

# --- Diarization (pyannote) — the speaker attribution path ---
# Required, not optional: this is how the pipeline learns who spoke when. Install
# the extra first (pip install -e ".[diarization]"), accept the licences for both
# pyannote/speaker-diarization-3.1 and its segmentation dependency on their
# HuggingFace model pages, then paste a read token here.
HUGGINGFACE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# Whisper has unloaded before diarization runs, so the card is free.
PYANNOTE_DEVICE=cuda
# Off means no attribution at all — every remote speaker becomes "Unknown".
# Only sensible on a machine with no GPU and no HF token.
DIARIZATION_ENABLED=true

# --- LLM (minutes, grounding, translation) ---
# "groq", "google", "openai", or "anthropic". The minutes code never names a
# provider; everything that makes the output trustworthy sits above the interface.
# Put the real key ONLY in your .env (which is gitignored) — never here.
LLM_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids are provider-specific — change these when you change provider.
# groq:      llama-3.3-70b-versatile / llama-3.1-8b-instant  (console.groq.com/docs/models)
# google:    gemini-2.5-pro / gemini-2.5-flash
# openai:    gpt-5.6
# anthropic: claude-opus-4-8 / claude-sonnet-5
MINUTES_MODEL=llama-3.3-70b-versatile
GROUNDING_MODEL=llama-3.1-8b-instant
TRANSLATION_MODEL=llama-3.3-70b-versatile

# --- RAG (add-on, phase 2) ---
CHROMA_DIR=./chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
